# Local MySQL development only. In Render, the Blueprint references the cloud service.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=
DB_PASSWORD=
DB_NAME=
# Use the database CA certificate for remote MySQL. In Render it is inherited.
DB_CA=

KITCHEN_CUSTOMER_USERNAME=ryj
KITCHEN_CHEF_USERNAME=chef
KITCHEN_CUSTOMER_PASSWORD=
KITCHEN_CHEF_PASSWORD=
KITCHEN_SESSION_SECRET=
PORT=3001

# Optional Brevo HTTPS email notifications. Leave the key unset to disable.
BREVO_API_KEY=
KITCHEN_EMAIL_FROM=
KITCHEN_CHEF_EMAIL=
KITCHEN_CUSTOMER_EMAIL=
# Render supplies RENDER_EXTERNAL_URL. For local mail testing, set the link origin.
# KITCHEN_PUBLIC_URL=http://127.0.0.1:3001
